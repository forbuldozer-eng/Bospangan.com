# Cloudflare Pages route compatibility for existing Vercel dynamic routes.
# Use .html detail templates outside the public slug folders to avoid directory-index redirects.
# These are internal rewrites (200), not browser redirects.
/landingpage/:slug /landingpage/index.html?slug=:slug 200
/landingpage/:slug/ /landingpage/index.html?slug=:slug 200
/blog/:slug /blog/article.html?slug=:slug 200
/blog/:slug/ /blog/article.html?slug=:slug 200

/promo-fnb/:slug /promo-fnb/article.html?slug=:slug 200
/promo-fnb/:slug/ /promo-fnb/article.html?slug=:slug 200
