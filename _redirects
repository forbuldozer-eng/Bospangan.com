# Keep the public blog listing at /blog/ unchanged.
# Keep the blog index accessible at both canonical and non-trailing-slash paths.
/blog /blog/index.html 200
/blog/ /blog/index.html 200

# Internally serve the shared detail template for /blog/<slug>/ URLs.
/blog/* /article-templates/blog-detail?slug=:splat 200

# Existing landing page slug routing.
/landingpage/* /landingpage/index.html?slug=:splat 200

# Promo F&B remains on hold.
/promo-fnb /blog/ 302
/promo-fnb/ /blog/ 302
/promo-fnb/* /blog/ 302
