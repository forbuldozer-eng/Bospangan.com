{
  "rewrites": [
    {
      "source": "/landingpage/:slug",
      "destination": "/landingpage/index.html?slug=:slug"
    },
    {
      "source": "/landingpage/:slug/",
      "destination": "/landingpage/index.html?slug=:slug"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/article.html?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bospangan.com"
        }
      ],
      "destination": "https://www.bospangan.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
